# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Airflow
AIRFLOW_UID=50000
AIRFLOW__API_AUTH__JWT_SECRET=change_me_to_a_long_random_string
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
ENV_FILE_PATH=.env

# Optional: point to a custom Airflow image name
# AIRFLOW_IMAGE_NAME=apache/airflow:3.0.0

# Optional: override project dir for volume mounts
# AIRFLOW_PROJ_DIR=.
